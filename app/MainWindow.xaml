<Window x:Class="app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity Multi-Session Hub"
        Icon="app.ico"
        Width="450" Height="640"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        FontFamily="Segoe UI, Segoe UI Variable">
    <Window.Resources>
        <!-- Modern Rounded Button Template -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Background" Value="#222838"/>
            <Setter Property="Foreground" Value="#F0F2F8"/>
            <Setter Property="BorderBrush" Value="#3B4866"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#323B52"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#5B709E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1F2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="#1D4E89"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#173D6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button -->
        <Style x:Key="WindowCtrlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E9CB2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#30FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Translucent Dark Acrylic Outer Container -->
    <Border Background="#F20F121C" CornerRadius="18" BorderBrush="#35FFFFFF" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.75"/>
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Active Account Card -->
                <RowDefinition Height="Auto"/> <!-- Quota Indicators -->
                <RowDefinition Height="*"/>    <!-- Dynamic Profiles ScrollViewer -->
                <RowDefinition Height="Auto"/> <!-- Footer / Status -->
            </Grid.RowDefinitions>

            <!-- 1. Title Bar (Draggable) -->
            <Grid Grid.Row="0" Margin="0,0,0,12" x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Antigravity 2.0" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text=" • Multi-Session Hub" FontSize="14" Foreground="#7A8CA5" Margin="4,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnPin" Style="{StaticResource WindowCtrlButton}" Content="📌" ToolTip="Ghim cửa sổ trên cùng" Click="BtnPin_Click"/>
                    <Button x:Name="BtnMin" Style="{StaticResource WindowCtrlButton}" Content="―" ToolTip="Thu nhỏ" Click="BtnMin_Click"/>
                    <Button x:Name="BtnClose" Style="{StaticResource WindowCtrlButton}" Content="✕" ToolTip="Đóng" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. Active Account Card -->
            <Border Grid.Row="1" Background="#181D2B" CornerRadius="14" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar Icon -->
                    <Border Width="38" Height="38" CornerRadius="19" Background="#1D2A44" BorderBrush="#3B82F6" BorderThickness="1.5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAvatarLetter" Text="✦" Foreground="#60A5FA" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Account Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PHIÊN ĐANG KẾT NỐI" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,6,0"/>
                            <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtActiveEmail" Text="Đang đọc session..." FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Add to List Button -->
                    <Button Grid.Column="2" x:Name="BtnAddCurrent" Style="{StaticResource AccentButton}" Content="➕ Lưu tài khoản" ToolTip="Lưu session tài khoản hiện tại vào danh sách" Padding="8,5" FontSize="11" VerticalAlignment="Center" Click="BtnAddCurrent_Click"/>
                </Grid>
            </Border>

            <!-- 3. Quotas Section -->
            <Border Grid.Row="2" Background="#181D2B" CornerRadius="14" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="HẠN MỨC SESSION HIỆN TẠI" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>

                    <!-- Weekly Limit -->
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Gemini Weekly Limit" FontSize="11" Foreground="#CBD5E1"/>
                        <TextBlock x:Name="TxtWeeklyPct" Text="--%" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="7" CornerRadius="3.5" Background="#0F1420" Margin="0,0,0,2">
                        <ProgressBar x:Name="PbWeekly" Height="7" Minimum="0" Maximum="100" Value="0" Background="Transparent" Foreground="#38BDF8" BorderThickness="0"/>
                    </Border>
                    <TextBlock x:Name="TxtWeeklyReset" Text="Reset: --" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,0,6"/>

                    <!-- 5-Hour Limit -->
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Rolling 5-Hour Limit" FontSize="11" Foreground="#CBD5E1"/>
                        <TextBlock x:Name="Txt5hPct" Text="--%" FontSize="11" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="7" CornerRadius="3.5" Background="#0F1420" Margin="0,0,0,2">
                        <ProgressBar x:Name="Pb5h" Height="7" Minimum="0" Maximum="100" Value="0" Background="Transparent" Foreground="#34D399" BorderThickness="0"/>
                    </Border>
                    <TextBlock x:Name="Txt5hReset" Text="Reset: --" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- 4. Dynamic Profile List Header & Scroll Area -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,6">
                    <TextBlock x:Name="TxtProfileCount" Text="DANH SÁCH TÀI KHOẢN (0)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="1-Click Switch" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Scrollable Account List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ProfilesContainer" Margin="0,0,4,0"/>
                </ScrollViewer>
            </Grid>

            <!-- 5. Footer / Status Message -->
            <Border Grid.Row="4" Background="#141824" CornerRadius="10" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtStatus" Text="Sẵn sàng" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" x:Name="BtnRefresh" Style="{StaticResource GlassButton}" Padding="8,4" FontSize="11" Content="⟳ Làm mới" Click="BtnRefresh_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
